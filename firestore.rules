rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Own profile + settings: user can read/write only their own doc.
    match /profiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /user_settings/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything under users/{uid}/... (gear, songs, sessions, chords,
    // oracle history, collections) belongs to that user only.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Built-in tuning presets are readable by anyone signed in.
    // Custom presets (with user_id set) are writable by their owner.
    match /tuning_presets/{presetId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.user_id == request.auth.uid;
    }
  }
}
