# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Secrets — never commit (Gemini key backup, etc.)
.secrets/

# Node (functions/ Cloud Function)
node_modules/

# Machine-local Android SDK/Flutter paths
/android/local.properties

# Gradle's problems-report lands in android/build (the real build output is
# redirected to /build by android/build.gradle.kts)
/android/build/

# Kotlin compiler session/lock files
.kotlin/

# Backup droppings (e.g. firebase_options.dart.bak) — local only
*.bak

# Local build helpers (machine-specific paths, read .secrets/)
/run_*.ps1
